# Copy to .env for local development (.env is git-ignored).
# On Railway/Render/Vercel set these in the dashboard instead.

NODE_ENV=development
PORT=3000

# Sentry: Project Settings > Client Keys (DSN). Leave empty to disable Sentry.
SENTRY_DSN=

# Required in production
JWT_SECRET=change-me

# Pino log level: trace | debug | info | warn | error | fatal | silent
# (default: debug in development, info in production)
LOG_LEVEL=

# Enables /api/debug-sentry* test routes. Local only; ignored when NODE_ENV=production.
ENABLE_DEBUG_ROUTES=false

# Used by /api/status to check the frontend, and by CORS
FRONTEND_URL=
CORS_ORIGIN=*
